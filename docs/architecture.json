  "cards": [
    { "dot": "emerald", "title": "Playback path", "items": [
      "StreamResolver picks AVPlayer for MP4/MOV with standard codecs and VLCKit for the rest (MKV, DTS, PGS)",
      "Atmos and HDR files can go through a lossless Plex HLS remux; a failed direct play falls back to a Plex direct stream",
      "A finished download plays from the device instead of the server"
    ] },
    { "dot": "violet", "title": "Dolby Vision 7", "items": [
      "AVPlayerEngine starts a loopback proxy that pulls Plex's HLS remux",
      "Each fragment's RPU is rewritten to profile 8.1 by the IthacaDovi Rust library",
      "A failed conversion retries the same remux as its HDR10 base layer"
    ] },
    { "dot": "rose", "title": "Credentials", "items": [
      "The Plex account token lives in the Keychain; preferences in UserDefaults",
      "Seerr signs in with the Plex token, and plain HTTP is refused outside the local network"
    ] },
    { "dot": "amber", "title": "Not drawn", "items": [
      "Describe It runs on the device; Athena (a self-hosted server that asks Claude) only after the viewer agrees",
      "Top Shelf extension reads a snapshot from the App Group group.com.inceptyon.ithaca"
    ] }
  ]
