From 03d1e12d010f4007936a43cf9bb2d9e978288dc9 Mon Sep 17 00:00:00 2001
From: Ithaca <ithaca@localhost>
Date: Wed, 21 Oct 2026 21:13:05 -0400
Subject: [PATCH] audiounit_ios: keep the tvOS route multichannel between
 titles

Stop() reset the session's preferred output channel count to 2. On
Apple TV that switched the HDMI route to stereo after every title, and
the receiver renegotiated. The next title (an episode autoplaying)
started on a route still at 2 channels. tvOS now leaves the preferred
count alone on Stop();
the app sets it for each title before playback (2 for stereo sources).
iOS keeps the reset.
---
 modules/audio_output/audiounit_ios.m | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/modules/audio_output/audiounit_ios.m b/modules/audio_output/audiounit_ios.m
index 2fc7072..5662fd7 100644
--- a/modules/audio_output/audiounit_ios.m
+++ b/modules/audio_output/audiounit_ios.m
@@ -291,7 +291,15 @@ avas_resetPreferredNumberOfChannels(audio_output_t *p_aout)
 
     if (p_sys->b_preferred_channels_set)
     {
+#if TARGET_OS_TV
+        /* Keep the HDMI route multichannel between titles. Dropping it to
+         * stereo on every Stop() made the receiver renegotiate, and the next
+         * title started on a 2-channel route. The app sets the route for
+         * each title before playback. */
+        (void) instance;
+#else
         [instance setPreferredOutputNumberOfChannels:2 error:nil];
+#endif
         p_sys->b_preferred_channels_set = false;
     }
 }
